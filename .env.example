# ── Frontend Environment Variables (Next.js) ──────────────────────────────────
# Rename these to NEXT_PUBLIC_* for production deployment on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id-here

# ── Legacy Vite Variables (kept for backward compatibility) ────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id-here

# ── Resend Email Configuration (Server-side) ──────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

