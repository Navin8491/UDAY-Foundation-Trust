PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

JWT_SECRET=your_jwt_secret_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Uday Foundation Trust <your-verified-sender@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=admin@udayfoundationstrust.org

# Payment Gateway Configuration
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Admin Creation Credentials (used by scripts to seed the database)
ADMIN_EMAIL=admin@udayfoundationstrust.org
ADMIN_PASSWORD=your_secure_admin_password_here

# Rate Limiting Configuration
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_FORM_WINDOW_MS=3600000
RATE_LIMIT_FORM_MAX=10
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
